# Copy this file to .env if you want to override defaults.
# The app runs without a .env file — MongoDB is already configured in code.

# Optional. Leave unset to use the built-in database connection.
# Do not change the default MongoDB URI unless you have your own cluster.
# MONGODB_URI=

# Optional JWT signing secret (a development default is used if unset)
JWT_SECRET=

# Optional server port (default 3000)
PORT=3000

# Optional — only needed if you use Gemini features
GEMINI_API_KEY=
